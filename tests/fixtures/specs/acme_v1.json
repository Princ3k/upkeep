{
  "openapi": "3.0.3",
  "info": { "title": "Acme API", "version": "2026-04-01" },
  "paths": {
    "/v1/invoices": {
      "get": {
        "operationId": "listInvoices",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } }
        ]
      }
    },
    "/v1/charges": {
      "post": { "operationId": "createCharge" }
    }
  },
  "components": {
    "schemas": {
      "InvoiceLine": {
        "type": "object",
        "properties": {
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "lines": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
